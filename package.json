{
  "name": "pm_automation_js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:setup": "prisma generate --schema=packages/database/prisma/schema.prisma && prisma db push --schema=packages/database/prisma/schema.prisma",
    "test": "turbo run test"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "turbo": "latest"
  }
}
